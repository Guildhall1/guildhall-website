# Copy this file to ".env" and fill in the values.

# Contact form endpoint (for example a Formspree form URL such as
# https://formspree.io/f/abcdwxyz). This URL is designed to be public,
# so it is safe in client-side code. Never put private API keys here:
# anything starting with VITE_ is visible to visitors.
VITE_FORM_ENDPOINT=

# Routing mode: "history" gives clean URLs like /about (recommended).
# "hash" gives URLs like /#/about and works on any host without setup.
VITE_ROUTER_MODE=history
